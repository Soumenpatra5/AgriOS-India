VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MSG_SENDER_ID=
VITE_FB_APP_ID=

# Vercel serverless (Firebase Admin)
FB_PROJECT_ID=
FB_CLIENT_EMAIL=
FB_PRIVATE_KEY=

# Existing keys
ANTHROPIC_API_KEY=
OTP_JWT_SECRET=
TWOFACTOR_API_KEY=
FAST2SMS_API_KEY=

# ── Commerce backend (see COMMERCE-BACKEND-SPEC.md) ──────────────────────────
# Supabase Postgres. Use the TRANSACTION pooler connection string (port 6543).
# Server-only — NEVER prefix with VITE_. Also set this as a GitHub Actions secret
# for the DB Migrate workflow.
DATABASE_URL=

# Razorpay (B2 onwards). Secrets are server-only; the key id is publishable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# Client switch: set to 1 to source the marketplace from /api/commerce/* instead
# of the local IndexedDB store. Leave empty until the backend above is provisioned.
VITE_COMMERCE_API=

# Upstash Redis for fleet-wide rate limiting (B4). Server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# B4 hardening (server-only)
CRON_SECRET=                    # secures the reservation-timeout cron
ORDER_RESERVATION_TTL_MIN=30    # cancel unpaid orders older than this (minutes)
PLATFORM_COMMISSION_BPS=0       # marketplace commission in basis points (250 = 2.5%)
