{
  "name": "agrios-india",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "build:e2e:auth": "vite build --mode e2e-auth",
    "preview": "vite preview",
    "test": "vitest run",
    "test:auth": "vitest run api/_lib/__tests__ src/services/__tests__",
    "test:e2e": "playwright test --config playwright.config.js",
    "test:e2e:auth": "npx firebase-tools emulators:exec --only auth \"playwright test --config auth.playwright.config.js e2e-browser/auth.pw.js\"",
    "load-server": "node load-harness/server.mjs",
    "load-test": "k6 run load-test.js",
    "lint": "eslint .",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "migrate": "node scripts/migrate.mjs",
    "release-stale": "node scripts/release-stale.mjs",
    "check:db": "node scripts/check-db.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
    "check:upstash": "node scripts/check-upstash.mjs",
    "lint:emulator": "node scripts/check-emulator-leak.js",
    "verify:auth": "npm run test:auth && npm run lint && npm run lint:emulator"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@vercel/blob": "^2.8.0",
    "firebase": "^12.16.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.469.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.10.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
